# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables
# for both Production and Preview.

# Supabase project (EU region): Project Settings → API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy anon key also works here.
# Public by design; access is limited by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection for Drizzle (server only, secret).
# Supabase → Connect → Transaction pooler (port 6543), with the database password.
# Use the same project as NEXT_PUBLIC_SUPABASE_URL. The app connects with TLS to
# any non-local host; add ?sslmode=... only to override that.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Comma-separated emails that may sign in, each with an optional role
# (admin, sales, engineering, supply; default sales). The role only seeds
# users.role on first login. Anyone not listed is rejected.
ALLOWED_EMAILS=justus@example.com:admin,nils@example.com:sales,marc@example.com:engineering,volker@example.com:supply

# Optional, tests only: a disposable local Postgres whose database name ends in _test.
# db/rls.test.ts wipes it and runs every migration. Leave empty to skip those tests.
TEST_DATABASE_URL=

# Nexar (Octopart) supply API — optional until phase 6 credentials are issued.
# portal.nexar.com → application → Client ID / Secret. Scope: supply.domain.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# Shared secret for Vercel Cron → GET /api/cron/weekly-cost (Authorization: Bearer …).
# Generate a long random string; set the same value in Vercel project env.
CRON_SECRET=

# Resend — outbound RFQs and inbound supplier replies (phase 7).
# API key from resend.com; FROM must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=rfq@your-domain.com
# Optional reply-to / inbound address (defaults to FROM). Point Resend receiving here.
RESEND_RFQ_REPLY_TO=rfq@your-domain.com
# Webhook signing secret from Resend → Webhooks (email.received → /api/webhooks/resend).
RESEND_WEBHOOK_SECRET=

# OpenAI — supplier offer PDF extract only (never customer messages). Human confirm required.
OPENAI_API_KEY=
# Optional model override (default gpt-4.1-mini).
OPENAI_OFFER_MODEL=

# Pipedrive — one-way import of organizations, persons and open deals (phase 8).
# Personal API token from Pipedrive → Settings → Personal preferences → API.
PIPEDRIVE_API_TOKEN=
